NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://username:password@host.neon.tech/wescol?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://username:password@host.neon.tech/wescol?sslmode=require
WEIGHMENT_DATA_PATH=../reports/Daily Weighment.csv
REPORT_DB_SERVER=
REPORT_DB_DATABASE=digiprod
REPORT_DB_USER=
REPORT_DB_PASSWORD=
REPORT_DB_DRIVER=ODBC Driver 17 for SQL Server
REPORT_DB_ENCRYPT=true
REPORT_DB_TRUST_SERVER_CERTIFICATE=true
REPORT_DB_CONNECTION_TIMEOUT=30000
REPORT_DB_REQUEST_TIMEOUT=180000
# Optional overrides for the generated Parquet report datasets.
# PARQUET_REPORT_PATH=../reports/parquet-etl/data/report_base.parquet
# PARQUET_QC_REPORT_PATH=../reports/parquet-etl/data/fertilizer_issuance_validation.parquet
SESSION_MAX_AGE=604800000
# Copy this file to server/.env and replace the Gmail placeholders.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=PASTE_YOUR_GOOGLE_APP_PASSWORD_HERE
SMTP_FROM=your-gmail-address@gmail.com
SMTP_FROM_NAME=WESCOL Reports
# SMTP timeouts in milliseconds; keep these bounded in production.
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000
CLIENT_URL=http://localhost:5173
# CLIENT_URL may list multiple allowed frontend origins, comma-separated,
# e.g. for local dev + a deployed Vercel URL:
#   CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
# The backend uses this list to allow cross-origin, credentialed requests
# (CORS) only from these exact origins. On Render, set CLIENT_URL to just
# the deployed frontend's exact origin (no trailing slash), e.g.:
#   CLIENT_URL=https://your-app.vercel.app

# Frontend-only: set this in the Vercel project's environment variables to
# the deployed backend's origin (e.g. https://your-backend.onrender.com).
# Leave unset for local development so requests use Vite's dev-server proxy.
